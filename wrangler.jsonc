{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aedanxd",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "899bccaf-5a30-45fa-a39a-4d5def97e108","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "64eb4a4711d04a1caf92802a0c3efac2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
